{
  "keyboard_name": "macrov02",
  "manufacturer": "taira",
  "maintainer": "taira",
  "usb": {
    "vid": "0xFEED",
    "pid": "0x6061",
    "device_version": "1.0.0"
  },
  "bootloader": "rp2040",
  "diode_direction": "COL2ROW",
     "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
  "matrix": {
    "rows": 2,
    "cols": 3
  },
  "matrix_pins": {
    "direct": [
      ["GP3", "GP4", "GP5"],
      ["GP6", "GP7",  "GP8"]
    ]
  },
  "encoder": {
    "enabled": true,
    "rotary": [
      { "pin_a": "GP13", "pin_b": "GP12" },
      { "pin_a": "GP11", "pin_b": "GP10" }
    ]
  },
  "layouts": {
    "LAYOUT": {
      "layout": [
        { "matrix": [0,0], "x": 0, "y": 0 },
        { "matrix": [0,1], "x": 1, "y": 0 },
        { "matrix": [0,2], "x": 2, "y": 0 },

        { "matrix": [1,0], "x": 0, "y": 1 },
        { "matrix": [1,1], "x": 1, "y": 1 },
        { "matrix": [1,2], "x": 2, "y": 1 }
      ]
    }
  }
}
